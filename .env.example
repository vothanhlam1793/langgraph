# Create .env from this file, then add your OpenAI API key.
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4.1-mini
# Optional: use an OpenAI-compatible provider instead of api.openai.com.
OPENAI_BASE_URL=https://your-provider.example/v1

# Optional: trace LangChain and LangGraph runs in LangSmith.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=langgraph-starter
